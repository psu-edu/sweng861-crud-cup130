# Application
PORT=3000

# Auth0
AUTH0_DOMAIN=<your-tenant>.us.auth0.com
AUTH0_AUDIENCE=https://sweng861-api
AUTH0_CLIENT_ID=<your application client ID>
AUTH0_CLIENT_SECRET=<your application client secret>
SESSION_SECRET=<a long random local secret>

# PostgreSQL - application connection
DATABASE_URL=postgresql://sweng861:change-me@db:5432/sweng861

# PostgreSQL - container initialization
POSTGRES_USER=sweng861
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sweng861